SEARCH_PROVIDER=geoapify
GEOAPIFY_API_KEY=
GEOAPIFY_DAILY_BUDGET=1000
GEOAPIFY_DAILY_CREDITS=2000
GEOAPIFY_BUDGET_FILE=.geoapify-budget.db
APP_ACCESS_TOKEN=
DATABASE_URL=postgresql+psycopg://trafficgo:trafficgo@localhost:5432/trafficgo
CORS_ORIGINS=[]
DAILY_PROVIDER_BUDGET=2000
API_REQUESTS_PER_MINUTE=180
TILE_REQUESTS_PER_MINUTE=600
PROVIDER_BUDGET_FILE=.provider-budget.json
ROUTING_PROVIDER=valhalla
# Optional traffic-aware routing. Keep disabled until account licence is checked.
TOMTOM_API_KEY=
TOMTOM_ROUTING_LICENSE_CONFIRMED=false
# Generic motorcycle API support does not establish Vietnam road restrictions.
TOMTOM_MOTORCYCLE_VIETNAM_VERIFIED=false
# Explicit development opt-in; does not certify Vietnam road restrictions.
TOMTOM_MOTORCYCLE_EXPERIMENTAL_ENABLED=false
# Base URL or full /route URL. Public demo is development-only; no production default.
VALHALLA_URL=
# Legacy VALHALLA_BASE_URL is still accepted; VALHALLA_URL takes precedence.
INTERACTIVE_DAILY_ROUTING_LIMIT=96
INTERACTIVE_ROUTING_BUDGET_FILE=.routing-budget.db
# Separate explicit worker only. Live routing is opt-in, never used in simulations.
DEPARTURE_LIVE_ROUTING_ENABLED=false
DEPARTURE_DAILY_ROUTING_LIMIT=24
JWT_SECRET=
JWT_ISSUER=trafficgo
JWT_AUDIENCE=trafficgo
